#!/usr/bin/env bash
# awake — keep the Mac awake even with the lid closed.
#
# Usage:
#   awake                  Run in the foreground; Ctrl+C restores sleep and exits.
#   awake -t 1h            Run in the foreground for 1 hour, then auto-stop.
#   awake -b 20            Auto-stop when battery drops to 20% (on battery power).
#   awake -s               Auto-stop when the Mac stays hot for 3 minutes.
#   awake start            Run in the background; persists across shell exit.
#   awake start -t 1h      Run in the background for 1 hour, then auto-stop.
#   awake status           Show whether awake is running and the pmset state.
#   awake stop             Stop a background awake started with `awake start`.
#   awake --help           Show help.
#   awake --version        Show version.

set -u

AWAKE_VERSION="0.2.0"

if [[ "$(uname -s)" != "Darwin" ]]; then
  echo "awake: macOS only" >&2
  exit 1
fi

STATE_DIR="${AWAKE_STATE_DIR:-$HOME/.local/state/awake}"
PID_FILE="$STATE_DIR/awake.pid"
DEADLINE_FILE="$STATE_DIR/awake.deadline"
BATTERY_FILE="$STATE_DIR/awake.battery"
SAFE_FILE="$STATE_DIR/awake.safe"
LOG_FILE="$STATE_DIR/awake.log"

BATTERY_POLL_SECS=60
THERMAL_POLL_SECS=60
THERMAL_HOT_SECS=180   # --safe: stop after this long at "serious" or worse

print_help() {
  cat <<'USAGE'
awake — keep the Mac awake even with the lid closed

Usage:
  awake                  Run in the foreground. Ctrl+C to release and exit.
  awake -t DURATION      Run in the foreground for DURATION, then auto-stop.
  awake -b PERCENT       Auto-stop when battery drops to PERCENT% (on battery).
  awake -s               Auto-stop when the Mac stays hot for 3 minutes.
  awake start            Run in the background (detached). Survives shell exit.
  awake start -t DURATION -b PERCENT -s
                         Run in the background with time/battery/thermal limits.
  awake status           Show running state, PID, uptime, and pmset disablesleep.
  awake stop             Stop a background awake and restore sleep settings.
  awake -h|--help        Show this help.
  awake -v|--version     Show version.

Duration format (-t / --timeout):
  Combine units h/m/s, e.g. 1h, 30m, 45s, 1h30m, 2h15m30s.
  A bare integer is treated as seconds: `-t 3600` == `-t 1h`.

Battery threshold (-b / --battery):
  Integer 1-99. Auto-stops when battery percentage drops to or below this
  value while on battery power. Checks every 60s. Skipped while on AC power.

Safe mode (-s / --safe):
  Auto-stops when macOS thermal pressure stays at "serious" or worse for
  3 minutes straight. Checks every 60s. Uses NSProcessInfo.thermalState, so
  no extra tools or sudo are needed. Note that macOS already throttles and
  protects the hardware on its own; -s just stops awake earlier so the Mac
  is not kept awake while it is too hot to do useful work.

  -t, -b and -s may be combined; whichever condition fires first stops awake.

State files:
  PID file:      $HOME/.local/state/awake/awake.pid
  Deadline file: $HOME/.local/state/awake/awake.deadline
  Battery file:  $HOME/.local/state/awake/awake.battery
  Safe file:     $HOME/.local/state/awake/awake.safe
  Log file:      $HOME/.local/state/awake/awake.log
  (Override the directory via AWAKE_STATE_DIR.)

Behavior:
  - Disables clamshell sleep via `pmset -a disablesleep 1` (sudo)
  - Prevents system idle sleep via `caffeinate -is`
  - sudo may prompt for a password once at startup. A root helper process
    started with that single authentication restores `disablesleep 0` when
    awake exits for any reason (Ctrl+C, SIGTERM, timeout, battery limit,
    thermal limit, even SIGKILL) — no second sudo prompt at exit.
USAGE
}

parse_battery_threshold() {
  local input="${1%\%}"  # tolerate a trailing '%' (e.g. `-b 20%`)
  if [[ ! "$input" =~ ^[0-9]+$ ]]; then
    return 1
  fi
  if (( input < 1 || input > 99 )); then
    return 1
  fi
  printf '%s' "$input"
}

# Read current battery percentage (integer 0-100). Empty string if unavailable
# (e.g. desktop Mac without a battery).
battery_percent() {
  pmset -g batt 2>/dev/null | awk '
    match($0, /[0-9]+%/) {
      pct = substr($0, RSTART, RLENGTH - 1)
      print pct
      exit
    }
  '
}

# "ac" if currently on wall power, "battery" if discharging, "" if unknown.
power_source() {
  pmset -g batt 2>/dev/null | awk '
    /Now drawing from/ {
      if (index($0, "AC Power")) { print "ac"; exit }
      if (index($0, "Battery Power")) { print "battery"; exit }
    }
  '
}

# macOS thermal pressure as reported by NSProcessInfo.thermalState:
# 0 = nominal, 1 = fair, 2 = serious, 3 = critical. Empty string if unavailable.
THERMAL_SERIOUS=2

thermal_state() {
  osascript -l JavaScript -e 'ObjC.import("Foundation"); $.NSProcessInfo.processInfo.thermalState' 2>/dev/null \
    | tr -d '[:space:]'
}

thermal_state_name() {
  case "${1:-}" in
    0) printf 'nominal' ;;
    1) printf 'fair' ;;
    2) printf 'serious' ;;
    3) printf 'critical' ;;
    *) printf 'unknown' ;;
  esac
}

# Parse a duration like "1h30m", "45s", "2h", or a bare integer (seconds).
# Prints the total seconds to stdout on success; exits non-zero on parse error.
parse_duration() {
  local input="$1"
  if [[ -z "$input" ]]; then
    return 1
  fi
  # Bare integer = seconds.
  if [[ "$input" =~ ^[0-9]+$ ]]; then
    if (( input <= 0 )); then
      return 1
    fi
    printf '%s' "$input"
    return 0
  fi
  # Combined units. Each unit may appear at most once and must be in h/m/s order.
  if [[ ! "$input" =~ ^([0-9]+h)?([0-9]+m)?([0-9]+s)?$ ]]; then
    return 1
  fi
  local h="${BASH_REMATCH[1]%h}"
  local m="${BASH_REMATCH[2]%m}"
  local s="${BASH_REMATCH[3]%s}"
  h="${h:-0}"; m="${m:-0}"; s="${s:-0}"
  local total=$(( h * 3600 + m * 60 + s ))
  if (( total <= 0 )); then
    return 1
  fi
  printf '%s' "$total"
}

pmset_disablesleep_value() {
  # `pmset -a disablesleep N` shows up under "System-wide power settings:" as
  # `SleepDisabled N`. Default is 0 when no override is set.
  pmset -g 2>/dev/null | awk '/SleepDisabled/ {print $2; exit}'
}

is_running() {
  local pid="$1"
  [[ -n "$pid" ]] && kill -0 "$pid" 2>/dev/null
}

read_pid() {
  [[ -f "$PID_FILE" ]] || return 1
  local pid
  pid="$(cat "$PID_FILE" 2>/dev/null || true)"
  [[ "$pid" =~ ^[0-9]+$ ]] || return 1
  printf '%s' "$pid"
}

# Find any foreground awake instance (no PID file) by walking caffeinate
# parents. Prints PIDs of matching awake processes, one per line.
find_foreground_awake_pids() {
  # Gather caffeinate PIDs from pmset assertions.
  local caff_pids
  caff_pids="$(pmset -g assertions 2>/dev/null \
    | awk 'match($0, /pid [0-9]+\(caffeinate\)/) {
        s = substr($0, RSTART + 4, RLENGTH - 4)
        sub(/\(.*/, "", s)
        print s
      }' | sort -u)"
  [[ -z "$caff_pids" ]] && return 0

  local cpid ppid pcmd
  local self_pid="$$"
  while read -r cpid; do
    [[ -z "$cpid" ]] && continue
    ppid="$(ps -o ppid= -p "$cpid" 2>/dev/null | tr -d ' ')"
    [[ -z "$ppid" || "$ppid" == "1" ]] && continue
    pcmd="$(ps -o command= -p "$ppid" 2>/dev/null)"
    # Match the awake script (run via `bash .../bin/awake` or executed directly).
    # Skip the detached background mode (handled by PID file) and skip ourselves.
    if [[ "$pcmd" == *"/awake"* || "$pcmd" == *" awake "* || "$pcmd" == *" awake" ]]; then
      [[ "$pcmd" == *"__detached"* ]] && continue
      [[ "$ppid" == "$self_pid" ]] && continue
      printf '%s\n' "$ppid"
    fi
  done <<<"$caff_pids"
}

# Read elapsed running time (in seconds) for a PID. Uses `ps -o etime=`,
# which emits `[[DD-]HH:]MM:SS` and avoids `date -f` (BSD date refuses to
# parse some valid future years).
process_uptime_secs() {
  local pid="$1"
  local raw
  raw="$(ps -o etime= -p "$pid" 2>/dev/null | awk '{$1=$1; print}')"
  [[ -z "$raw" ]] && return 1

  # Split optional `DD-` prefix.
  local days=0 hms="$raw"
  if [[ "$hms" == *-* ]]; then
    days="${hms%%-*}"
    hms="${hms#*-}"
  fi

  # `hms` is now `HH:MM:SS` or `MM:SS`. Split on `:`.
  local IFS=:
  local -a parts=($hms)
  unset IFS
  local h=0 m=0 s=0
  case ${#parts[@]} in
    3) h="${parts[0]}"; m="${parts[1]}"; s="${parts[2]}" ;;
    2) m="${parts[0]}"; s="${parts[1]}" ;;
    *) return 1 ;;
  esac

  # Strip leading zeros to avoid octal interpretation in arithmetic.
  days=$(( 10#${days} ))
  h=$(( 10#${h} ))
  m=$(( 10#${m} ))
  s=$(( 10#${s} ))

  printf '%s' "$(( days * 86400 + h * 3600 + m * 60 + s ))"
}

format_uptime() {
  local secs="$1"
  local d=$(( secs / 86400 ))
  local h=$(( (secs % 86400) / 3600 ))
  local m=$(( (secs % 3600) / 60 ))
  local s=$(( secs % 60 ))
  if (( d > 0 )); then
    printf '%dd %02dh %02dm %02ds' "$d" "$h" "$m" "$s"
  elif (( h > 0 )); then
    printf '%dh %02dm %02ds' "$h" "$m" "$s"
  elif (( m > 0 )); then
    printf '%dm %02ds' "$m" "$s"
  else
    printf '%ds' "$s"
  fi
}

# ---------- foreground runner (the actual work loop) ----------

run_foreground() {
  local mode="${1:-attached}"     # attached | detached
  local timeout_secs="${2:-0}"    # 0 = no timeout
  local battery_threshold="${3:-0}" # 0 = no battery limit
  local safe_mode="${4:-0}"         # 1 = stop when hot for THERMAL_HOT_SECS

  CAFFEINATE_PID=""
  TIMER_PID=""
  BATTERY_PID=""
  THERMAL_PID=""
  HELPER_PID=""
  HELPER_FIFO=""
  HELPER_STATUS=""
  HELPER_FD_OPEN=0
  DISABLED_SLEEP=0

  cleanup() {
    trap - INT TERM HUP EXIT

    if [[ -n "$TIMER_PID" ]] && kill -0 "$TIMER_PID" 2>/dev/null; then
      kill "$TIMER_PID" 2>/dev/null || true
      wait "$TIMER_PID" 2>/dev/null || true
    fi

    if [[ -n "$BATTERY_PID" ]] && kill -0 "$BATTERY_PID" 2>/dev/null; then
      kill "$BATTERY_PID" 2>/dev/null || true
      wait "$BATTERY_PID" 2>/dev/null || true
    fi

    if [[ -n "$THERMAL_PID" ]] && kill -0 "$THERMAL_PID" 2>/dev/null; then
      kill "$THERMAL_PID" 2>/dev/null || true
      wait "$THERMAL_PID" 2>/dev/null || true
    fi

    if [[ -n "$CAFFEINATE_PID" ]] && kill -0 "$CAFFEINATE_PID" 2>/dev/null; then
      kill "$CAFFEINATE_PID" 2>/dev/null || true
      wait "$CAFFEINATE_PID" 2>/dev/null || true
    fi

    if [[ "$DISABLED_SLEEP" -eq 1 ]]; then
      echo ""
      echo "awake: restoring sleep settings (root helper; no sudo prompt)"
    fi

    # Closing our end of the FIFO delivers EOF to the root helper, which
    # then runs `pmset -a disablesleep 0` with the privileges it already
    # holds — no fresh sudo credential (and no password prompt) needed.
    if [[ "$HELPER_FD_OPEN" -eq 1 ]]; then
      exec 9>&-
      HELPER_FD_OPEN=0
    fi
    if [[ -n "$HELPER_PID" ]]; then
      wait "$HELPER_PID" 2>/dev/null || true
    fi
    if [[ -n "$HELPER_FIFO" ]]; then
      rm -f "$HELPER_FIFO" "$HELPER_STATUS"
    fi

    if [[ "$DISABLED_SLEEP" -eq 1 && "$(pmset_disablesleep_value)" == "1" ]]; then
      echo "awake: root helper did not restore pmset; falling back to sudo" >&2
      sudo -n pmset -a disablesleep 0 \
        || sudo pmset -a disablesleep 0 \
        || echo "awake: failed to restore pmset. Run manually: sudo pmset -a disablesleep 0" >&2
    fi

    if [[ "$mode" == "detached" ]]; then
      rm -f "$PID_FILE" "$DEADLINE_FILE" "$BATTERY_FILE" "$SAFE_FILE"
    fi
  }

  trap cleanup INT TERM HUP EXIT

  mkdir -p "$STATE_DIR"

  # Root helper: a single sudo authentication covers both the enable now and
  # the restore at exit. The helper enables disablesleep, then blocks reading
  # a FIFO whose write end only this process holds. When this process exits
  # for ANY reason — Ctrl+C, SIGTERM, timeout, battery/thermal limit, even SIGKILL —
  # the FIFO hits EOF and the helper restores disablesleep=0 as root, so no
  # sudo password is ever needed at exit.
  HELPER_FIFO="$STATE_DIR/helper.$$.fifo"
  HELPER_STATUS="$STATE_DIR/helper.$$.status"
  rm -f "$HELPER_FIFO" "$HELPER_STATUS"
  if ! mkfifo -m 600 "$HELPER_FIFO"; then
    echo "awake: failed to create FIFO at $HELPER_FIFO" >&2
    exit 1
  fi
  # Open our end read-write: O_RDWR on a FIFO never blocks, and holding a
  # read end ourselves means writes to fd 9 can never raise SIGPIPE.
  exec 9<>"$HELPER_FIFO"
  HELPER_FD_OPEN=1

  echo "awake: disabling sleep (sudo may ask for your password — once; exit never prompts)"
  # `9>&-` keeps the helper from inheriting our write end (which would block
  # its own EOF forever). Children below get the same treatment.
  sudo bash -c '
    fifo="$1" status="$2"
    # Survive Ctrl+C / SIGTERM / SIGHUP aimed at the foreground process
    # group: the helper must outlive awake to restore sleep settings.
    trap "" INT TERM HUP
    exec 0<"$fifo"
    if ! pmset -a disablesleep 1; then
      echo failed > "$status"
      exit 1
    fi
    echo ok > "$status"
    # Block until EOF (= awake exited, however it died). Lines written by
    # awake carry state, e.g. the caffeinate PID to reap on abnormal exit.
    caff=""
    while read -r line; do
      case "$line" in
        caffeinate=*) caff="${line#caffeinate=}" ;;
      esac
    done
    pmset -a disablesleep 0
    if [ -n "$caff" ]; then
      kill "$caff" 2>/dev/null || true
    fi
    echo "awake: sleep settings restored (pmset -a disablesleep 0)"
    rm -f "$fifo" "$status"
  ' _ "$HELPER_FIFO" "$HELPER_STATUS" 9>&- &
  HELPER_PID=$!

  # Wait for the helper to report the pmset result. This can take a while:
  # sudo may be prompting for a password. Bail out if the helper dies first
  # (auth failure, Ctrl+C at the prompt). A zombie (stat Z) counts as dead —
  # we have not reaped it yet, so plain liveness checks would spin forever.
  local pm_status="" helper_stat=""
  while :; do
    pm_status="$(cat "$HELPER_STATUS" 2>/dev/null || true)"
    [[ -n "$pm_status" ]] && break
    helper_stat="$(ps -o stat= -p "$HELPER_PID" 2>/dev/null | tr -d ' ')"
    if [[ -z "$helper_stat" || "$helper_stat" == Z* ]]; then
      break
    fi
    sleep 0.1
  done
  if [[ "$pm_status" != "ok" ]]; then
    echo "awake: failed to configure pmset" >&2
    exit 1
  fi
  DISABLED_SLEEP=1

  caffeinate -is 9>&- &
  CAFFEINATE_PID=$!
  # Tell the helper which caffeinate to reap if we die without cleanup.
  echo "caffeinate=$CAFFEINATE_PID" >&9

  local parent=$$

  if (( timeout_secs > 0 )); then
    local deadline=$(( $(date +%s) + timeout_secs ))
    if [[ "$mode" == "detached" ]]; then
      echo "$deadline" > "$DEADLINE_FILE"
    fi
    # Timer child: after the timeout, signal our parent (this shell) so the
    # cleanup trap runs and pmset is restored. Using SIGTERM keeps the exit
    # path identical to `awake stop` / Ctrl+C.
    (
      sleep "$timeout_secs"
      kill -TERM "$parent" 2>/dev/null || true
    ) 9>&- &
    TIMER_PID=$!
  fi

  if (( battery_threshold > 0 )); then
    if [[ "$mode" == "detached" ]]; then
      echo "$battery_threshold" > "$BATTERY_FILE"
    fi
    # Battery monitor child: polls pmset; signals parent when on battery and
    # at/below threshold. Skips polls while on AC power.
    (
      while sleep "$BATTERY_POLL_SECS"; do
        kill -0 "$parent" 2>/dev/null || exit 0
        local src pct
        src="$(power_source)"
        if [[ "$src" != "battery" ]]; then
          continue
        fi
        pct="$(battery_percent)"
        if [[ -z "$pct" ]]; then
          continue
        fi
        if (( pct <= battery_threshold )); then
          echo "awake: battery at ${pct}% (<= ${battery_threshold}%); stopping" >&2
          kill -TERM "$parent" 2>/dev/null || true
          exit 0
        fi
      done
    ) 9>&- &
    BATTERY_PID=$!
  fi

  if (( safe_mode )); then
    if [[ "$mode" == "detached" ]]; then
      echo "1" > "$SAFE_FILE"
    fi
    # Thermal monitor child: polls thermal pressure; signals parent once it
    # has stayed at "serious" or worse for THERMAL_HOT_SECS straight.
    (
      hot_since=""
      while sleep "$THERMAL_POLL_SECS"; do
        kill -0 "$parent" 2>/dev/null || exit 0
        local state now
        state="$(thermal_state)"
        if [[ ! "$state" =~ ^[0-9]+$ ]]; then
          continue
        fi
        if (( state < THERMAL_SERIOUS )); then
          hot_since=""
          continue
        fi
        now="$(date +%s)"
        if [[ -z "$hot_since" ]]; then
          hot_since="$now"
          echo "awake: thermal pressure is $(thermal_state_name "$state"); will stop if it stays hot for $(format_uptime "$THERMAL_HOT_SECS")" >&2
          continue
        fi
        if (( now - hot_since >= THERMAL_HOT_SECS )); then
          echo "awake: thermal pressure has been serious or worse for $(format_uptime $(( now - hot_since ))) (now $(thermal_state_name "$state")); stopping" >&2
          kill -TERM "$parent" 2>/dev/null || true
          exit 0
        fi
      done
    ) 9>&- &
    THERMAL_PID=$!
  fi

  local startup_msg="awake: running (PID=$$, caffeinate PID=$CAFFEINATE_PID"
  if (( timeout_secs > 0 )); then
    startup_msg+=", timeout=$(format_uptime "$timeout_secs")"
  fi
  if (( battery_threshold > 0 )); then
    startup_msg+=", battery<=${battery_threshold}%"
  fi
  if (( safe_mode )); then
    startup_msg+=", safe"
  fi
  startup_msg+=")"
  echo "$startup_msg"
  echo "awake: the Mac will stay awake with the lid closed. Press Ctrl+C to release and exit."

  while kill -0 "$CAFFEINATE_PID" 2>/dev/null; do
    wait "$CAFFEINATE_PID" 2>/dev/null
  done
}

# ---------- subcommands ----------

cmd_start() {
  local timeout_secs="${1:-0}"
  local battery_threshold="${2:-0}"
  local safe_mode="${3:-0}"
  mkdir -p "$STATE_DIR"

  if pid="$(read_pid)" && is_running "$pid"; then
    echo "awake: already running (PID=$pid). Use 'awake stop' first." >&2
    exit 1
  fi
  rm -f "$PID_FILE" "$DEADLINE_FILE" "$BATTERY_FILE" "$SAFE_FILE"

  # Prime sudo in the foreground so the background child can use the cached
  # credential without prompting.
  echo "awake: priming sudo (you may be asked for your password)"
  sudo -v || { echo "awake: sudo authentication failed" >&2; exit 1; }

  # Re-exec self in the background, detached from this shell. Trailing args:
  # __detached <timeout_secs> <battery_threshold> <safe_mode> (0 = unset).
  nohup "$0" __detached "$timeout_secs" "$battery_threshold" "$safe_mode" >>"$LOG_FILE" 2>&1 </dev/null &
  local child=$!
  disown "$child" 2>/dev/null || true

  # Wait briefly for the child to write its PID / start caffeinate.
  local waited=0
  while (( waited < 30 )); do
    if pid="$(read_pid)" && is_running "$pid"; then
      echo "awake: started in background (PID=$pid)"
      if (( timeout_secs > 0 )); then
        echo "awake: will auto-stop after $(format_uptime "$timeout_secs")"
      fi
      if (( battery_threshold > 0 )); then
        echo "awake: will auto-stop when battery drops to ${battery_threshold}% (on battery power)"
      fi
      if (( safe_mode )); then
        echo "awake: will auto-stop if thermal pressure stays serious for $(format_uptime "$THERMAL_HOT_SECS")"
      fi
      echo "awake: logs -> $LOG_FILE"
      echo "awake: stop with 'awake stop'"
      return 0
    fi
    sleep 0.1
    waited=$(( waited + 1 ))
  done

  echo "awake: background process did not start cleanly. Check $LOG_FILE" >&2
  exit 1
}

cmd_detached() {
  local timeout_secs="${1:-0}"
  local battery_threshold="${2:-0}"
  local safe_mode="${3:-0}"
  mkdir -p "$STATE_DIR"
  echo "$$" > "$PID_FILE"
  run_foreground detached "$timeout_secs" "$battery_threshold" "$safe_mode"
}

cmd_status() {
  local pid="" running=0
  if pid="$(read_pid)" && is_running "$pid"; then
    running=1
  elif [[ -f "$PID_FILE" ]]; then
    echo "awake: stale PID file at $PID_FILE (process not running)"
  fi

  local disablesleep
  disablesleep="$(pmset_disablesleep_value)"
  disablesleep="${disablesleep:-unknown}"

  if (( running )); then
    local now uptime started_epoch
    now="$(date +%s)"
    uptime="$(process_uptime_secs "$pid" || true)"

    echo "awake: running (background)"
    echo "  pid:                $pid"
    if [[ -n "$uptime" ]]; then
      started_epoch=$(( now - uptime ))
      echo "  started:            $(date -r "$started_epoch" "+%Y-%m-%d %H:%M:%S %Z")"
      echo "  uptime:             $(format_uptime "$uptime")"
    fi
    if [[ -f "$DEADLINE_FILE" ]]; then
      local deadline remaining
      deadline="$(cat "$DEADLINE_FILE" 2>/dev/null || true)"
      if [[ "$deadline" =~ ^[0-9]+$ ]]; then
        remaining=$(( deadline - now ))
        echo "  auto-stop at:       $(date -r "$deadline" "+%Y-%m-%d %H:%M:%S %Z")"
        if (( remaining > 0 )); then
          echo "  remaining:          $(format_uptime "$remaining")"
        else
          echo "  remaining:          (deadline passed; stopping shortly)"
        fi
      fi
    fi
    if [[ -f "$BATTERY_FILE" ]]; then
      local threshold pct src
      threshold="$(cat "$BATTERY_FILE" 2>/dev/null || true)"
      if [[ "$threshold" =~ ^[0-9]+$ ]]; then
        pct="$(battery_percent)"
        src="$(power_source)"
        echo "  battery threshold:  ${threshold}% (now ${pct:-?}%, source: ${src:-unknown})"
      fi
    fi
    if [[ -f "$SAFE_FILE" ]]; then
      echo "  safe mode:          on (stop after $(format_uptime "$THERMAL_HOT_SECS") at serious; now $(thermal_state_name "$(thermal_state)"))"
    fi
    echo "  pmset disablesleep: $disablesleep"
    echo "  log:                $LOG_FILE"
  else
    # No background awake. Look for foreground awake instances (no PID file).
    local fg_pids
    fg_pids="$(find_foreground_awake_pids)"

    if [[ -n "$fg_pids" ]]; then
      local fg_pid started_epoch now uptime fg_count=0
      now="$(date +%s)"
      # Count for header wording (singular vs plural).
      local total
      total="$(printf '%s\n' "$fg_pids" | grep -c .)"

      if (( total == 1 )); then
        echo "awake: running (foreground in another shell)"
      else
        echo "awake: running (foreground in $total other shells)"
      fi

      while read -r fg_pid; do
        [[ -z "$fg_pid" ]] && continue
        fg_count=$(( fg_count + 1 ))
        if (( total > 1 )); then
          echo "  --- instance $fg_count ---"
        fi
        echo "  pid:                $fg_pid"
        uptime="$(process_uptime_secs "$fg_pid" || true)"
        if [[ -n "$uptime" ]]; then
          started_epoch=$(( now - uptime ))
          echo "  started:            $(date -r "$started_epoch" "+%Y-%m-%d %H:%M:%S %Z")"
          echo "  uptime:             $(format_uptime "$uptime")"
        fi
      done <<<"$fg_pids"
      echo "  pmset disablesleep: $disablesleep"
      echo "  stop with:          Ctrl+C in the shell that started it (or 'kill -TERM <pid>')"
    else
      echo "awake: not running (background)"
      echo "  pmset disablesleep: $disablesleep"
      if [[ "$disablesleep" == "1" ]]; then
        echo "  warning: disablesleep is 1 but no awake process is tracked."
        echo "  another tool may hold it, or a prior awake was force-killed."
        echo "  inspect with: pmset -g assertions"
        echo "  restore with: sudo pmset -a disablesleep 0"
      fi
    fi
  fi
}

# Force-restore pmset disablesleep to 0 if it is still 1. Used by `awake stop`
# whenever the cleanup trap could not run (no PID file, stale PID, SIGKILL
# fallback) so the user is never left with a Mac that refuses to sleep.
restore_disablesleep_if_stuck() {
  local reason="$1"
  local disablesleep
  disablesleep="$(pmset_disablesleep_value)"
  [[ "$disablesleep" == "1" ]] || return 0

  echo "awake: pmset disablesleep is still 1${reason:+ ($reason)}; restoring"
  echo "awake: restoring sleep settings (sudo pmset -a disablesleep 0)"
  sudo -n pmset -a disablesleep 0 \
    || sudo pmset -a disablesleep 0 \
    || echo "awake: failed to restore pmset. Run manually: sudo pmset -a disablesleep 0" >&2
}

cmd_stop() {
  local pid
  if ! pid="$(read_pid)"; then
    echo "awake: no PID file at $PID_FILE — nothing to stop"
    restore_disablesleep_if_stuck "no tracked awake process"
    exit 1
  fi

  if ! is_running "$pid"; then
    echo "awake: PID $pid not running — cleaning up stale PID file"
    rm -f "$PID_FILE" "$DEADLINE_FILE" "$BATTERY_FILE" "$SAFE_FILE"
    restore_disablesleep_if_stuck "previous run may have been force-killed"
    exit 0
  fi

  echo "awake: stopping PID $pid"
  kill -TERM "$pid" 2>/dev/null || { echo "awake: kill failed" >&2; exit 1; }

  local waited=0
  while (( waited < 50 )); do
    if ! is_running "$pid"; then
      echo "awake: stopped"
      return 0
    fi
    sleep 0.1
    waited=$(( waited + 1 ))
  done

  echo "awake: process did not exit after SIGTERM; sending SIGKILL"
  kill -KILL "$pid" 2>/dev/null || true
  rm -f "$PID_FILE" "$DEADLINE_FILE" "$BATTERY_FILE" "$SAFE_FILE"
  restore_disablesleep_if_stuck "cleanup trap did not run"
}

# ---------- dispatch ----------

# Extract a subcommand and -t/-b/-s flags from arbitrary argv order.
# Recognized subcommands: (empty)|fg|foreground|start|status|stop|__detached
# -t/--timeout DURATION may appear before or after the subcommand.
SUBCMD=""
TIMEOUT_RAW=""
BATTERY_RAW=""
SAFE_MODE=0
DETACHED_TIMEOUT_SECS=""
DETACHED_BATTERY_THRESHOLD=""
DETACHED_SAFE_MODE=""

while (( $# > 0 )); do
  case "$1" in
    -h|--help)
      print_help
      exit 0
      ;;
    -v|--version)
      echo "awake $AWAKE_VERSION"
      exit 0
      ;;
    -t|--timeout)
      if (( $# < 2 )); then
        echo "awake: $1 requires a DURATION argument (e.g. 1h, 30m, 90s, 3600)" >&2
        exit 2
      fi
      TIMEOUT_RAW="$2"
      shift 2
      ;;
    --timeout=*)
      TIMEOUT_RAW="${1#--timeout=}"
      shift
      ;;
    -t*)
      # Allow `-t1h` (no space).
      TIMEOUT_RAW="${1#-t}"
      shift
      ;;
    -b|--battery)
      if (( $# < 2 )); then
        echo "awake: $1 requires a PERCENT argument (integer 1-99)" >&2
        exit 2
      fi
      BATTERY_RAW="$2"
      shift 2
      ;;
    --battery=*)
      BATTERY_RAW="${1#--battery=}"
      shift
      ;;
    -b*)
      # Allow `-b20` (no space).
      BATTERY_RAW="${1#-b}"
      shift
      ;;
    -s|--safe)
      SAFE_MODE=1
      shift
      ;;
    fg|foreground|start|status|stop)
      if [[ -n "$SUBCMD" ]]; then
        echo "awake: unexpected extra argument: $1" >&2
        exit 2
      fi
      SUBCMD="$1"
      shift
      ;;
    __detached)
      # Internal: invoked by `awake start` via nohup. Not a public subcommand.
      # Expects: __detached <timeout_secs> <battery_threshold> <safe_mode>
      SUBCMD="__detached"
      shift
      DETACHED_TIMEOUT_SECS="${1:-0}"
      shift || true
      DETACHED_BATTERY_THRESHOLD="${1:-0}"
      shift || true
      DETACHED_SAFE_MODE="${1:-0}"
      shift || true
      ;;
    *)
      echo "awake: unknown argument: $1" >&2
      echo "Run 'awake --help' for usage." >&2
      exit 2
      ;;
  esac
done

TIMEOUT_SECS=0
if [[ -n "$TIMEOUT_RAW" ]]; then
  if ! TIMEOUT_SECS="$(parse_duration "$TIMEOUT_RAW")"; then
    echo "awake: invalid duration: '$TIMEOUT_RAW' (use 1h, 30m, 45s, 1h30m, or a positive integer of seconds)" >&2
    exit 2
  fi
fi

BATTERY_THRESHOLD=0
if [[ -n "$BATTERY_RAW" ]]; then
  if ! BATTERY_THRESHOLD="$(parse_battery_threshold "$BATTERY_RAW")"; then
    echo "awake: invalid battery threshold: '$BATTERY_RAW' (use an integer 1-99, with or without %)" >&2
    exit 2
  fi
fi

case "$SUBCMD" in
  ""|fg|foreground)
    run_foreground attached "$TIMEOUT_SECS" "$BATTERY_THRESHOLD" "$SAFE_MODE"
    ;;
  start)
    cmd_start "$TIMEOUT_SECS" "$BATTERY_THRESHOLD" "$SAFE_MODE"
    ;;
  status)
    cmd_status
    ;;
  stop)
    cmd_stop
    ;;
  __detached)
    cmd_detached "$DETACHED_TIMEOUT_SECS" "$DETACHED_BATTERY_THRESHOLD" "$DETACHED_SAFE_MODE"
    ;;
esac
